# Copy to .env, then run scripts/launch.sh (Linux VPS) or:
#   docker compose up -d --build
#
# Generate a token with: openssl rand -hex 32
# Use at least 16 characters. This same admin token is used by the app.
MEMORYDB_TOKEN=replace-with-a-long-random-token

# Public HTTP port for the app. Set UNIVORYA_BIND=127.0.0.1 when using the
# optional Caddy HTTPS profile, so only Caddy is reachable from the internet.
UNIVORYA_PORT=8000
# UNIVORYA_BIND=127.0.0.1

# 1 shows the eight fictional demo projects on a fresh database. Set 0 for a
# private/empty gallery.
UNIVORYA_SEED_DEMO=1

# Loopback port for direct MemoryDB operator access. Never expose it publicly.
MEMORYDB_PORT=8080

# HTTPS profile only:
#   docker compose --profile https up -d --build
# UNIVORYA_DOMAIN=showcase.example.com
# When Caddy is the only public entry point and UNIVORYA_BIND=127.0.0.1:
# FORWARDED_ALLOW_IPS=*

# --- Local Python development (not read by docker compose) -------------------
# UNIVORYA_DATA_DIR=./data
# UNIVORYA_STORE=sqlite
# MEMORYDB_URL=memorydb://TOKEN@127.0.0.1:8080

# --- Google Sign-In (optional) ------------------------------------------------
# Create an OAuth 2.0 Web client in Google Cloud Console, then add the callback
# as an authorized redirect URI:
#   https://your-domain/auth/google/callback   (production)
#   http://localhost:8000/auth/google/callback (local)
# Leave both empty to hide the "Continue with Google" button.
# GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# GOOGLE_REDIRECT_URI=https://your-domain/auth/google/callback
#
# For offline development only, scripts/dev_mock_google.py speaks the same
# protocol. Never point these three at a mock in production:
# GOOGLE_AUTH_URL=http://127.0.0.1:8099/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=http://127.0.0.1:8099/token
# GOOGLE_USERINFO_URL=http://127.0.0.1:8099/userinfo

# --- Univorya Studio (AI coding workspace) -----------------------------------
# Studio lets a project owner connect their own OpenAI / Claude / OpenRouter key,
# chat with a coding agent, and preview the running app in a split pane.
# Set 0 to hide Studio entirely.
# UNIVORYA_STUDIO=1
#
# Encrypts every stored model key at rest with Fernet. Set a long random value in
# production and keep it stable — without it, local mode generates one key file:
#   openssl rand -hex 32
# UNIVORYA_SECRET_KEY=
#
# The built-in runner is local: commands run as the app service account inside
# DATA_DIR/studio. That is fine for a self-hosted single-user install. A
# per-workspace Docker runner is the production follow-up; until it exists, only
# enable Studio for people you trust.
#
# Dedicated preview host that proxies signed /preview/<token>/ URLs, for example:
#   UNIVORYA_PREVIEW_ORIGIN=https://preview.example.com
# When the preview host differs from the app host, also name the app's public origin
# so the preview can be framed only by Studio:
#   UNIVORYA_APP_ORIGIN=https://showcase.example.com
# Leave both empty for local loopback previews (http://127.0.0.1:<port>).
# UNIVORYA_PREVIEW_ORIGIN=
# UNIVORYA_APP_ORIGIN=
#
# --- Studio Git + agent CLI (optional) ---------------------------------------
# Git powers the Studio Git tab and the git_* agent tools. The Docker image
# installs it; set an explicit path only when git is not on PATH:
# UNIVORYA_GIT_BINARY=/usr/bin/git
#
# Studio can also use an agent CLI that is already installed and signed in on the
# server (Claude Code, Codex CLI, Gemini CLI, or any command that accepts a
# {prompt} placeholder). The user picks it in the Model tab; their own API key, if
# supplied, is exported only to that child process. Install the CLI into a derived
# image or on the host before enabling this. Timeout in seconds:
# UNIVORYA_STUDIO_CLI_TIMEOUT=300
#
# Git credentials (personal access tokens) are stored per user, Fernet-encrypted
# with UNIVORYA_SECRET_KEY. Clone accepts https:// URLs, loopback http:// Git
# servers and local paths; SSH URLs are rejected because Studio has no SSH agent.
